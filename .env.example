# Copy to .env and fill in. Never commit .env.
# Values shown are the local-development defaults from docker-compose.yml.

# --- Database -----------------------------------------------------------
# Local compose defaults. Use strong, unique credentials anywhere else.
POSTGRES_SUPERUSER_PASSWORD=postgres
DB_NAME=customer_intelligence
DB_USER=app
DB_PASSWORD=app
POSTGRES_URI=postgresql://app:app@postgres:5432/customer_intelligence
POSTGRES_SCHEMA=public

# --- LangGraph checkpointer ---------------------------------------------
CHECKPOINT_DB_NAME=copilot_checkpoint
CHECKPOINT_POSTGRES_URI=postgresql://app:app@postgres:5432/copilot_checkpoint
CHECKPOINT_SETUP_ON_STARTUP=true
LANGGRAPH_CHECKPOINT_ENABLED=true
CHECKPOINT_POOL_MAX_SIZE=10

# --- Postgres roles (RLS personas) --------------------------------------
CI_COPILOT_ROLE=ci_copilot
CI_COPILOT_HOD_ROLE=ci_copilot_hod
CI_COPILOT_EXEC_ROLE=ci_copilot_exec
CI_LOADER_ROLE=ci_loader
CI_ANALYST_ROLE=ci_analyst
# Leave empty to create ci_analyst as NOLOGIN. Set to enable password login.
CI_ANALYST_PASSWORD=

# --- Schemas ------------------------------------------------------------
CI_CORE_SCHEMA=ci_core
CI_HOD_SCHEMA=ci_hod
CI_EXEC_SCHEMA=ci_exec
CI_META_SCHEMA=ci_meta

# --- LLM provider -------------------------------------------------------
LLM_PROVIDER=gemini
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# Gemini / Vertex AI. Auth via `gcloud auth application-default login`.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-southeast1
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-2.5-flash

# OpenAI. Only needed when LLM_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# --- Reference data -----------------------------------------------------
GLOSSARY_SOURCE=postgres
GLOSSARY_CSV_PATH=/app/data/v3_column_glossary.csv
METRIC_CSV_PATH=/app/data/v3_metric_definition_seed.csv
STORE_CSV_PATH=/app/data/store_name.csv
PRODUCT_CATALOG_CSV_PATH=/app/data/product_catalog.csv

# --- Observability ------------------------------------------------------
MLFLOW_TRACKING_ENABLED=true
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT_NAME=customer-intelligence-copilot
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=
MLFLOW_GEMINI_AUTOLOG_ENABLED=true
CI_ACCESS_LOG_ENABLED=true

# --- Runtime limits -----------------------------------------------------
MAX_QUERY_ROWS=500
CHAT_HISTORY_LIMIT=12
MAX_RESULT_PREVIEW_ROWS=100
STREAM_CHUNK_SIZE=120
MAX_SQL_RETRIES=2
API_TIMEOUT_SECONDS=180
SQL_TIMEOUT_SECONDS=60
CURRENCY_CODE=MYR
CURRENCY_SYMBOL=RM
